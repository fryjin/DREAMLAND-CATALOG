{
  "schemaVersion": 2,
  "hcaptcha": {
    "enabled": true,
    "mode": "adaptive-risk",
    "loadStrategy": "contact-preload-risk-preview-render",
    "loadTimeoutMs": 12000
  },
  "privacyUrl": "./privacy.html",
  "privacyVersion": "2026-07-30",
  "customMoq": 50,
  "maxQuantity": 1000000,
  "archiveLimit": 20,
  "submitCooldownMs": 10000,
  "submissionTransport": "web3forms-direct",
  "inquiryClientConfigEndpoint": "/api/inquiry?client_config=1",
  "pwa": {
    "offlineStrategy": "on-demand",
    "installPromptDelayMs": 5000,
    "installDismissDays": 7,
    "updateCheckIntervalMs": 3600000,
    "productImageStrategy": "network-first",
    "connectivityProbeTimeoutMs": 4500,
    "connectivityProbeCacheMs": 12000,
    "connectivityProbeTarget": "risk-assessment",
    "installFallbackDelayMs": 15000,
    "installFallbackMode": "browser-menu-guide"
  },
  "submissionEndpoint": "/api/risk",
  "riskControl": {
    "enabled": true,
    "threshold": 3,
    "minimumSessionMs": 15000,
    "minimumFormMs": 8000,
    "minimumInteractions": 3,
    "repeatWindowMs": 600000,
    "repeatLimit": 2,
    "maximumUrls": 2,
    "kvBinding": "RISK_STORE"
  },
  "inquiryEndpoint": "/api/inquiry",
  "riskEndpoint": "/api/risk"
}
