---
interface Props {
  title:string;
  description:string;
  page:string;
  lang?:string;
  robots?:string;
  canonical?:string;
  ogImage?:string;
  productId?:string;
}

const {
  title,
  description,
  page,
  lang='en',
  robots='noindex,nofollow',
  canonical='https://dreamland-catalog.pages.dev/',
  ogImage='https://dreamland-catalog.pages.dev/images/shared/share/SHARE001/cover-social.jpg',
  productId=''
}=Astro.props;

const isHome=
  page==='home';

const isCatalog=
  page==='catalog';

const isProduct=
  page==='product';

const presentation=
  isHome
    ? 'astro-home-production'
    : isCatalog
      ? 'astro-catalog-static'
      : isProduct
        ? 'astro-pdp-static'
        : 'astro-static';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="dreamland-r4-presentation"
      content={presentation}
    />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f8f5ef" />
    <title>{title}</title>
  </head>
  <body
    data-r4-astro-home={isHome?'true':undefined}
    data-r4-home-static={isHome?'true':undefined}
    data-r4-production-home={isHome?'true':undefined}
    data-r4-astro-foundation={(isCatalog||isProduct)?'true':undefined}
    data-r4-astro-catalog={isCatalog?'true':undefined}
    data-r4-catalog-static={isCatalog?'true':undefined}
    data-r4-astro-product={isProduct?'true':undefined}
    data-r4-pdp-static={isProduct?'true':undefined}
    data-product-id={isProduct?productId:undefined}
    data-dreamland-page={page}
  >
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --home-canvas:#f8f5ef;
    --home-surface:#fffdf9;
    --home-sand:#ede4d8;
    --home-ink:#181512;
    --home-muted:#6e665f;
    --home-soft:#928981;
    --home-line:rgba(24,21,18,.13);
    --home-radius:24px;
    --home-max:1440px;
    --home-gutter:clamp(20px,4vw,64px);
    --home-section:clamp(88px,10vw,156px);
    --home-serif:Georgia,"Times New Roman",serif;
    --home-sans:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  }

  * {
    box-sizing:border-box;
  }

  html {
    margin:0;
    background:var(--home-canvas);
    color:var(--home-ink);
    scroll-behavior:smooth;
  }

  body {
    min-width:320px;
    min-height:100vh;
    margin:0;
    background:var(--home-canvas);
    color:var(--home-ink);
    font-family:var(--home-sans);
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
  }

  a {
    color:inherit;
    text-decoration:none;
  }

  img {
    max-width:100%;
  }

  button,
  input,
  select,
  textarea {
    font:inherit;
  }

  .home-container {
    width:min(
      calc(100% - (2 * var(--home-gutter))),
      var(--home-max)
    );
    margin-inline:auto;
  }

  .home-sr-only {
    position:absolute!important;
    width:1px!important;
    height:1px!important;
    padding:0!important;
    margin:-1px!important;
    overflow:hidden!important;
    clip:rect(0,0,0,0)!important;
    white-space:nowrap!important;
    border:0!important;
  }
</style>
