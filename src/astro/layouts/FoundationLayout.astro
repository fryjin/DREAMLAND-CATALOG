---
interface Props {
  title:string;
  description:string;
  page:string;
  productId?:string;
}

const {
  title,
  description,
  page,
  productId=''
}=Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <meta name="dreamland-r4-foundation" content="astro-static" />
    <title>{title}</title>
  </head>
  <body
    data-r4-astro-foundation="true"
    data-dreamland-page={page}
    data-product-id={productId}
  >
    <main class="r4-foundation-shell">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    color:#171513;
    background:#fbf8f3;
  }
  * { box-sizing:border-box; }
  html,body { margin:0; min-height:100%; }
  body { min-height:100vh; }
  .r4-foundation-shell {
    width:min(960px,calc(100% - 48px));
    margin:0 auto;
    padding:72px 0;
  }
  .r4-foundation-kicker {
    margin:0 0 14px;
    font-size:12px;
    font-weight:800;
    letter-spacing:.12em;
    text-transform:uppercase;
    opacity:.58;
  }
  .r4-foundation-shell h1 {
    margin:0 0 18px;
    font-size:clamp(42px,7vw,84px);
    line-height:.95;
    letter-spacing:-.05em;
  }
  .r4-foundation-shell p {
    max-width:680px;
    margin:0;
    font-size:16px;
    line-height:1.7;
    opacity:.72;
  }
</style>
