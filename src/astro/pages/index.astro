---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import {
  normalizeLocale,
  supportedLocale,
  htmlLangForLocale,
  localizePresentationRoutes,
  decorateLocaleRuntimeState
} from '../lib/locale-routing.mjs';
import HomePage from '../components/home/HomePage.astro';
import MobileStartupLoader from '../components/home/MobileStartupLoader.astro';
import {
  buildHomeViewModel,
  buildHomeRuntimeState
} from '../lib/home-view-model.mjs';
import {buildMobileHomeStartupManifest} from '../lib/mobile-home-startup.mjs';
import '../styles/home.css';
import '../styles/mobile-home.css';

import routes from '../../../data/page-routes.json';
import productsDocument from '../../../data/products.json';
import seriesDocument from '../../../data/series.json';
import siteContent from '../../../data/site-content.json';
import homeAssets from '../../../data/desktop-home-assets.json';
import mobileHomeAssets from '../../../data/mobile-home-assets.json';
import i18n from '../../../data/i18n.json';

import '../../domain/pricing/runtime-pricing-policy.js';
import '../../domain/localization/runtime-localization-policy.js';

if(routes.routes?.home?.path!=='/'){
  throw new Error(
    'R4.3B expected canonical Home route /.'
  );
}

const pricingPolicy=
  globalThis.DreamlandPricingPolicy;

const localizationPolicy=
  globalThis.DreamlandLocalizationPolicy;

if(
  !pricingPolicy||
  !localizationPolicy
){
  throw new Error(
    'R4.3B Home requires canonical Pricing and Localization Domain policies.'
  );
}

const routeLocale=supportedLocale(Astro.props.routeLocale)||'';
const language=normalizeLocale(Astro.props.language||routeLocale||'en');
const currentPath='/';

const supportedLanguages=[
  'en',
  'zh',
  'ko'
];

const sharedInput={
  siteContent,
  homeAssets,
  products:
    productsDocument.products||[],
  seriesMeta:
    seriesDocument.series||{},
  currencyMap:
    i18n.currencyMap||{},
  localizationPolicy,
  pricingPolicy
};

let view=
  buildHomeViewModel({
    language,
    ...sharedInput
  });

view=
  localizePresentationRoutes(
    view,
    routeLocale
  );

let runtimeState=
  buildHomeRuntimeState({
    languages:
      supportedLanguages,
    defaultLanguage:
      language,
    ...sharedInput
  });

const mobileStartup=
  buildMobileHomeStartupManifest({
    products:productsDocument.products||[],
    assets:mobileHomeAssets
  });

const mobileStartupJson=
  JSON.stringify(mobileStartup)
    .replace(/</g,'\\u003c');

runtimeState=
  decorateLocaleRuntimeState(
    runtimeState,
    routeLocale
  );

const runtimeStateJson=
  JSON.stringify(
    runtimeState
  )
    .replace(
      /</g,
      '\\u003c'
    );

const content=view.content||{};

const languageOptions=
  supportedLanguages.map(
    value=>({
      value,
      label:
        i18n.currencyMap
          ?.[value]
          ?.label||
        value.toUpperCase()
    })
  );
---
<SiteLayout
  title="DREAMLAND — Hand-carved candles for wholesale and custom projects"
  description="Hand-carved candles for wholesale and custom projects."
  page="home"
  lang={htmlLangForLocale(language)}
  routeLocale={routeLocale}
  robots="index,follow"
  canonical="https://dreamlandart.net/"
  ogImage="https://dreamlandart.net/images/shared/share/SHARE001/cover-social.jpg"
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={mobileStartup.cover}
      media="(max-width:720px)"
      fetchpriority="high"
    />

    <link
      rel="preload"
      as="image"
      href={view.hero.desktopImage}
      media="(min-width:901px)"
      fetchpriority="high"
    />

    <link
      rel="preload"
      as="image"
      href={view.wholesale.image}
      media="(min-width:901px)"
      fetchpriority="low"
    />
  </Fragment>

  <MobileStartupLoader />

  <SiteHeader
    content={content}
    languageOptions={languageOptions}
    initialLanguage={language}
    routeLocale={routeLocale}
    currentPath={currentPath}
    coverLanguageMenu={true}
  />
  <HomePage view={view} mobileCover={mobileStartup.cover} routeLocale={routeLocale} />
  <SiteFooter
    routeLocale={routeLocale} content={content} />

  <script
    is:inline
    id="mobileHomeStartupState"
    type="application/json"
    set:html={mobileStartupJson}
  ></script>

  <script
    is:inline
    id="homeRuntimeState"
    type="application/json"
    set:html={runtimeStateJson}
  ></script>
  <script
    is:inline
    type="module"
    src="/r4-home-runtime.js"
  ></script>
</SiteLayout>
