---
import FoundationLayout from '../layouts/FoundationLayout.astro';
import routes from '../../../data/page-routes.json';

if(routes.routes?.home?.path!=='/'){
  throw new Error('R4 Astro foundation expected home route /.');
}
---
<FoundationLayout
  title="DREAMLAND R4 Astro Foundation"
  description="Isolated Astro static-generation proof of concept."
  page="home"
>
  <p class="r4-foundation-kicker">DREAMLAND · R4.1</p>
  <h1>Astro build foundation</h1>
  <p>
    This page is generated by the isolated R4 Astro build.
    It does not replace the current Production website.
  </p>
</FoundationLayout>
