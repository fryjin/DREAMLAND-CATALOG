---
import CanonicalPage from '../../../inquiry/success/index.astro';
import {SUPPORTED_LOCALES} from '../../../../lib/locale-routing.mjs';

export function getStaticPaths(){
  return SUPPORTED_LOCALES.map(language=>({
    params:{lang:language},
    props:{language}
  }));
}

const {language}=Astro.props;
---
<CanonicalPage language={language} routeLocale={language} />
