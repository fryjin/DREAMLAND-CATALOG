---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../components/site/SiteHeader.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import SuccessPage from '../../../components/success/SuccessPage.astro';

import {
  buildSuccessStaticView
} from '../../../lib/success-view-model.mjs';

import '../../../styles/home.css';
import '../../../styles/success.css';

import siteContent from '../../../../../data/site-content.json';
import i18n from '../../../../../data/i18n.json';
import routes from '../../../../../data/page-routes.json';

import '../../../../domain/localization/runtime-localization-policy.js';
import '../../../../site/runtime/runtime-page-guards.js';

if(
  routes.routes
    ?.review
    ?.path!==
  '/inquiry/review/'||
  routes.routes
    ?.review
    ?.guard!==
  'hasValidContact'||
  routes.routes
    ?.success
    ?.path!==
  '/inquiry/success/'||
  routes.routes
    ?.success
    ?.public!==
  false||
  routes.routes
    ?.success
    ?.guard!==
  'hasLastSubmission'
){
  throw new Error(
    'R4.10A expected canonical Review → Success route/guard contract.'
  );
}

const localizationPolicy=
  globalThis
    .DreamlandLocalizationPolicy;

const pageGuards=
  globalThis
    .DreamlandPageGuards;

if(
  !localizationPolicy||
  !pageGuards
){
  throw new Error(
    'R4.10A Success requires canonical Localization and PageGuards owners.'
  );
}

const language='en';

const supportedLanguages=[
  'en',
  'zh',
  'ko'
];

const view=
  buildSuccessStaticView({
    language,
    siteContent,
    localizationPolicy,
    pageGuards
  });

const languageOptions=
  supportedLanguages.map(
    value=>({
      value,
      label:
        i18n.currencyMap
          ?.[value]
          ?.label||
        value.toUpperCase()
    })
  );
---
<SiteLayout
  title="Inquiry Received — DREAMLAND"
  description={view.copy.successBody||'We have received your inquiry.'}
  page="success"
  lang={language}
  robots="noindex,nofollow"
  canonical="https://dreamland-catalog.pages.dev/inquiry/success/"
  ogImage="https://dreamland-catalog.pages.dev/images/shared/share/SHARE001/cover-social.jpg"
>
  <SiteHeader
    content={view.content}
    languageOptions={languageOptions}
    initialLanguage={language}
    languageEnabled={false}
  />

  <SuccessPage view={view} />

  <SiteFooter content={view.content} />
</SiteLayout>
