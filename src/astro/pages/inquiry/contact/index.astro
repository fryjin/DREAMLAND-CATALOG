---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../components/site/SiteHeader.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import {
  normalizeLocale,
  supportedLocale,
  htmlLangForLocale,
  localizePresentationRoutes,
  decorateLocaleRuntimeState
} from '../../../lib/locale-routing.mjs';
import ContactPage from '../../../components/contact/ContactPage.astro';

import {
  buildContactStaticView,
  buildContactRuntimeState
} from '../../../lib/contact-view-model.mjs';

import '../../../styles/home.css';
import '../../../styles/contact.css';

import siteContent from '../../../../../data/site-content.json';
import i18n from '../../../../../data/i18n.json';
import seriesDocument from '../../../../../data/series.json';
import routes from '../../../../../data/page-routes.json';

import '../../../../domain/localization/runtime-localization-policy.js';
import '../../../../features/inquiry/runtime-inquiry.js';
import '../../../../features/contact/runtime-contact.js';

if(
  routes.routes
    ?.contact
    ?.path!==
  '/inquiry/contact/'||
  routes.routes
    ?.contact
    ?.public!==
  false||
  routes.routes
    ?.contact
    ?.guard!==
  'hasInquiry'||
  routes.routes
    ?.inquiry
    ?.path!==
  '/inquiry/'||
  routes.routes
    ?.review
    ?.path!==
  '/inquiry/review/'
){
  throw new Error(
    'R4.8B expected canonical Inquiry → Contact → Review route contract.'
  );
}

const localizationPolicy=
  globalThis
    .DreamlandLocalizationPolicy;

const inquiryFeature=
  globalThis
    .DreamlandInquiry;

const contactFeature=
  globalThis
    .DreamlandContact;

if(
  !localizationPolicy||
  !inquiryFeature||
  !contactFeature
){
  throw new Error(
    'R4.8B Contact requires Localization, Inquiry and Contact canonical owners.'
  );
}

const routeLocale=supportedLocale(Astro.props.routeLocale)||'';
const language=normalizeLocale(Astro.props.language||routeLocale||'en');
const currentPath='/inquiry/contact/';

let view=
  buildContactStaticView({
    language,
    siteContent,
    i18n,
    localizationPolicy,
    contactFeature,
    inquiryFeature
  });

view=
  localizePresentationRoutes(
    view,
    routeLocale
  );

let runtimeState=
  buildContactRuntimeState({
    languages:[
      'en',
      'zh',
      'ko'
    ],
    defaultLanguage:
      language,
    siteContent,
    i18n,
    seriesDocument,
    localizationPolicy
  });

runtimeState=
  decorateLocaleRuntimeState(
    runtimeState,
    routeLocale
  );

const runtimeStateJson=
  JSON.stringify(
    runtimeState
  )
    .replace(
      /</g,
      '\\u003c'
    );

const languageOptions=[
  'en',
  'zh',
  'ko'
].map(
  value=>({
    value,
    label:
      i18n.currencyMap
        ?.[value]
        ?.label||
      value.toUpperCase()
  })
);
---
<SiteLayout
  title="Contact Details — DREAMLAND"
  description={view.copy.contactBody}
  page="contact"
  lang={htmlLangForLocale(language)}
  routeLocale={routeLocale}
  robots="noindex,nofollow"
  canonical="https://dreamlandart.net/inquiry/contact/"
  ogImage="https://dreamlandart.net/images/shared/share/SHARE001/cover-social.jpg"
>
  <SiteHeader
    content={view.content}
    languageOptions={languageOptions}
    initialLanguage={language}
    routeLocale={routeLocale}
    currentPath={currentPath}
    languageEnabled={true}
  />

  <ContactPage view={view} />

  <SiteFooter
    routeLocale={routeLocale} content={view.content} />

  <script
    is:inline
    id="contactRuntimeState"
    type="application/json"
    set:html={runtimeStateJson}
  ></script>
  <script
    is:inline
    type="module"
    src="/r4-contact-runtime.js"
  ></script>
</SiteLayout>
