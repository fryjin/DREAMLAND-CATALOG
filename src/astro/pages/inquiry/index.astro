---
import fs from 'node:fs';
import path from 'node:path';

import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import InquiryPage from '../../components/inquiry/InquiryPage.astro';

import {
  buildInquiryStaticView,
  buildInquiryRuntimeState,
  mapInquiryScents
} from '../../lib/inquiry-view-model.mjs';

import '../../styles/home.css';
import '../../styles/inquiry.css';

import siteContent from '../../../../data/site-content.json';
import i18n from '../../../../data/i18n.json';
import productsDocument from '../../../../data/products.json';
import seriesDocument from '../../../../data/series.json';
import appConfig from '../../../../data/app-config.json';
import routes from '../../../../data/page-routes.json';

import '../../../data/product-data-contract.js';
import '../../../domain/localization/runtime-localization-policy.js';
import '../../../features/inquiry/runtime-inquiry.js';

if(
  routes.routes
    ?.inquiry
    ?.path!==
  '/inquiry/'||
  routes.routes
    ?.inquiry
    ?.public!==
  false||
  routes.routes
    ?.contact
    ?.path!==
  '/inquiry/contact/'
){
  throw new Error(
    'R4.7B expected canonical Inquiry → Contact route contract.'
  );
}

const productDataContract=
  globalThis
    .DreamlandProductDataContract;

const localizationPolicy=
  globalThis
    .DreamlandLocalizationPolicy;

const inquiryFeature=
  globalThis
    .DreamlandInquiry;

if(
  !productDataContract||
  !localizationPolicy||
  !inquiryFeature
){
  throw new Error(
    'R4.7B Inquiry requires Product Data, Localization and DreamlandInquiry canonical owners.'
  );
}

const scentRows=
  productDataContract
    .parseCsv(
      fs.readFileSync(
        path.resolve(
          process.cwd(),
          'data/scents.csv'
        ),
        'utf8'
      )
    );

const scents=
  mapInquiryScents(
    scentRows
  );

const language='en';
const supportedLanguages=[
  'en',
  'zh',
  'ko'
];

const view=
  buildInquiryStaticView({
    language,
    siteContent,
    localizationPolicy,
    inquiryFeature
  });

const runtimeState=
  buildInquiryRuntimeState({
    languages:
      supportedLanguages,
    defaultLanguage:
      language,
    siteContent,
    i18n,
    productsDocument,
    seriesDocument,
    scents,
    appConfig,
    localizationPolicy
  });

const runtimeStateJson=
  JSON.stringify(
    runtimeState
  )
    .replace(
      /</g,
      '\\u003c'
    );

const languageOptions=
  supportedLanguages.map(
    value=>({
      value,
      label:
        i18n.currencyMap
          ?.[value]
          ?.label||
        value.toUpperCase()
    })
  );
---
<SiteLayout
  title="Inquiry — DREAMLAND"
  description={view.copy.body}
  page="inquiry"
  lang={language}
  robots="noindex,nofollow"
  canonical="https://dreamland-catalog.pages.dev/inquiry/"
  ogImage="https://dreamland-catalog.pages.dev/images/shared/share/SHARE001/cover-social.jpg"
>
  <SiteHeader
    content={view.content}
    languageOptions={languageOptions}
    initialLanguage={language}
    languageEnabled={true}
  />

  <InquiryPage view={view} />

  <SiteFooter content={view.content} />

  <script
    is:inline
    id="inquiryRuntimeState"
    type="application/json"
    set:html={runtimeStateJson}
  ></script>
  <script
    is:inline
    type="module"
    src="/r4-inquiry-runtime.js"
  ></script>
</SiteLayout>
