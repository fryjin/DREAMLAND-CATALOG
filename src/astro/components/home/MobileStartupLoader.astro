---
---
<div
  id="dreamlandMobileStartup"
  class="dl-mobile-startup"
  data-active="true"
  data-mobile-startup
  role="status"
  aria-live="polite"
  aria-label="Entering DREAMLAND"
>
  <div class="dl-mobile-startup__shell">
    <p class="dl-mobile-startup__index">DREAMLAND / 01</p>
    <p class="dl-mobile-startup__wordmark" aria-hidden="true">DREAMLAND</p>
    <p class="dl-mobile-startup__copy">A dream is taking shape.</p>
    <div
      class="dl-mobile-startup__progress"
      data-mobile-startup-progress
      role="progressbar"
      aria-label="Entering DREAMLAND"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="10"
    ><i></i></div>
    <p class="dl-mobile-startup__status" data-mobile-startup-status>Opening the first page</p>
  </div>
</div>
<noscript><style>#dreamlandMobileStartup{display:none!important}</style></noscript>
