---
interface Props {
  view:Record<string,any>;
}

const {view}=Astro.props;
const c=view.copy||{};
const contact=view.contact||{};

const contactRows=[
  {
    key:'name',
    label:c.name||'Contact Name',
    value:contact.name
  },
  {
    key:'company',
    label:c.company||'Company / Brand',
    value:contact.company
  },
  {
    key:'buyerType',
    label:c.buyerType||'Buyer Type',
    value:contact.buyerType
  },
  {
    key:'country',
    label:c.country||'Country / Region',
    value:contact.country
  },
  {
    key:'city',
    label:c.city||'City',
    value:contact.city
  },
  {
    key:'email',
    label:c.email||'Email',
    value:contact.email
  },
  {
    key:'phone',
    label:c.phone||'WhatsApp / Phone / WeChat',
    value:contact.phone
  },
  {
    key:'message',
    label:c.message||'Other Notes',
    value:contact.message
  }
];

const notProvided=c.notProvided||'Not provided';
---
<main
  class="review-main"
  data-review-static-presentation
  data-review-runtime-presentation
>
  <section
    class="review-hero"
    aria-labelledby="reviewTitle"
  >
    <div class="home-container review-hero__inner">
      <div>
        <p
          class="review-eyebrow"
          data-review-bind="reviewKicker"
        >
          {c.reviewKicker||'FINAL CHECK'}
        </p>
        <h1
          id="reviewTitle"
          data-review-bind="reviewTitle"
        >
          {c.reviewTitle||'Review and submit the inquiry.'}
        </h1>
      </div>

      <p
        class="review-hero__body"
        data-review-bind="reviewBody"
      >
        {c.reviewBody||'Check the contact details, product configurations and custom project requirements.'}
      </p>
    </div>
  </section>

  <nav
    class="review-progress home-container"
    aria-label={c.progressLabel||'Inquiry progress'}
    data-review-static-progress
  >
    <ol>
      <li
        class="is-complete"
        data-review-static-step="selection"
      >
        <strong>01</strong>
        <span data-review-bind="stepSelection">
          {c.stepSelection||'Inquiry'}
        </span>
      </li>
      <li
        class="is-complete"
        data-review-static-step="contact"
      >
        <strong>02</strong>
        <span data-review-bind="stepContact">
          {c.stepContact||'Contact'}
        </span>
      </li>
      <li
        class="is-active"
        data-review-static-step="review"
      >
        <strong>03</strong>
        <span data-review-bind="stepReview">
          {c.stepReview||'Review'}
        </span>
      </li>
    </ol>
  </nav>

  <section class="review-workspace home-container">
    <div class="review-content">
      <section
        class="review-section"
        data-review-static-contact
      >
        <header class="review-section__header">
          <div class="review-section__title">
            <span>01</span>
            <h2 data-review-bind="contactDetailsTitle">
              {c.contactDetailsTitle||'Contact details'}
            </h2>
          </div>

          <a
            href={view.routes.contact}
            data-review-static-edit-contact
          >
            <span data-review-bind="edit">
              {c.edit||'Edit'}
            </span>
            →
          </a>
        </header>

        <dl class="review-contact-grid">
          {contactRows.map((row:any)=>(
            <div data-review-static-contact-field={row.key}>
              <dt data-review-contact-label={row.key}>
                {row.label}
              </dt>
              <dd data-review-contact-value={row.key}>
                {row.value||notProvided||'—'}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section
        class="review-section"
        data-review-static-products
      >
        <header class="review-section__header">
          <div class="review-section__title">
            <span>02</span>
            <h2 data-review-bind="selectedProducts">
              {c.selectedProducts||'Inquiry items'}
            </h2>
          </div>

          <a
            href={view.routes.inquiry}
            data-review-static-edit-inquiry
          >
            <span data-review-bind="edit">
              {c.edit||'Edit'}
            </span>
            →
          </a>
        </header>

        <div data-review-products-list>
          <p
            class="review-empty"
            data-review-bind="none"
          >
            {c.none||'None'}
          </p>
        </div>
      </section>

      <section
        class="review-section"
        data-review-custom-section
        hidden
      >
        <header class="review-section__header">
          <div class="review-section__title">
            <span>03</span>
            <h2 data-review-bind="customProject">
              {c.customProject||'Custom project'}
            </h2>
          </div>

          <a href={view.routes.inquiry}>
            <span data-review-bind="edit">
              {c.edit||'Edit'}
            </span>
            →
          </a>
        </header>

        <div data-review-customs-list></div>
      </section>

      <section
        class="review-notice"
        data-review-static-notice
      >
        <div class="review-section__title">
          <span data-review-notice-index>03</span>
          <div>
            <p
              class="review-eyebrow"
              data-review-bind="beforeSubmitKicker"
            >
              {c.beforeSubmitKicker||'BEFORE SUBMISSION'}
            </p>
            <h2 data-review-bind="beforeSubmitTitle">
              {c.beforeSubmitTitle||'Submitting an inquiry does not place an order.'}
            </h2>
          </div>
        </div>

        <p data-review-bind="beforeSubmitBody">
          {c.beforeSubmitBody||'Pricing, production and delivery are confirmed only after the quotation is accepted.'}
        </p>
      </section>
    </div>

    <aside
      class="review-summary"
      data-review-static-summary
    >
      <p
        class="review-eyebrow"
        data-review-bind="summaryKicker"
      >
        {c.summaryKicker||'YOUR INQUIRY'}
      </p>

      <h2 data-review-bind="reviewSummaryTitle">
        {c.reviewSummaryTitle||c.summaryTitle||'Inquiry overview'}
      </h2>

      <div class="review-summary__rows">
        <div>
          <span data-review-bind="inquiryNumber">
            {c.inquiryNumber||'Inquiry ID'}
          </span>
          <strong
            data-review-static-inquiry-id
            data-review-inquiry-id
          >
            —
          </strong>
        </div>

        <div>
          <span data-review-bind="productEstimate">
            {c.productEstimate||'Estimated product amount'}
          </span>
          <strong
            data-review-static-estimate
            data-review-estimate
          >
            —
          </strong>
        </div>

        <div
          data-review-custom-summary
          hidden
        >
          <span data-review-bind="customProject">
            {c.customProject||'Custom project'}
          </span>
          <strong data-review-bind="customQuotedSeparately">
            {c.customQuotedSeparately||'Quoted separately'}
          </strong>
        </div>
      </div>

      <p
        class="review-summary__note"
        data-review-bind="beforeSubmitBody"
      >
        {c.beforeSubmitBody||'Pricing, production and delivery are confirmed only after the quotation is accepted.'}
      </p>

      <label
        class="review-consent"
        data-review-static-consent
      >
        <input
          type="checkbox"
          data-review-privacy
        />
        <span>
          <span data-review-bind="privacyPrefix">
            {c.privacyPrefix||'I have read and agree to the'}
          </span>
          <span
            class="review-consent__link"
            data-review-bind="privacyLink"
          >
            {c.privacyLink||'Privacy Notice'}
          </span>
        </span>
      </label>

      <section
        class="review-security"
        data-review-security
        hidden
        aria-live="polite"
      >
        <p class="review-security__copy" data-review-security-copy></p>
        <div data-review-captcha></div>
      </section>

      <button
        class="review-submit"
        type="button"
        disabled
        data-review-static-submit
        data-review-submit
      >
        <span data-review-bind="submitInquiry">
          {c.submitInquiry||'Submit Inquiry'}
        </span>
        <span aria-hidden="true">→</span>
      </button>

      <p
        class="review-static-status"
        data-review-static-status
        data-review-runtime-status
        role="status"
        aria-live="polite"
      ></p>
    </aside>
  </section>
</main>
