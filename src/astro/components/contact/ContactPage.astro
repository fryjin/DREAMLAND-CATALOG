---
interface Props {
  view:Record<string,any>;
}

const {view}=Astro.props;
const c=view.copy||{};
const contact=view.contact||{};
const summary=view.summary||{};
const countries=Array.isArray(view.countryRegions)?view.countryRegions:[];
const buyerTypes=Array.isArray(view.buyerTypes)?view.buyerTypes:[];

const requiredLabel=c.requiredLabel||'Required';
const optionalLabel=c.optionalLabel||'Optional';

const sections=[
  {
    key:'required',
    kickerKey:'requiredLabel',
    kicker:requiredLabel,
    titleKey:'contactRequiredTitle',
    title:c.contactRequiredTitle||'Required contact details',
    bodyKey:'contactRequiredBody',
    body:c.contactRequiredBody||'Complete these four fields to continue to review.',
    fields:['name','country','email','phone']
  },
  {
    key:'optional',
    kickerKey:'optionalLabel',
    kicker:optionalLabel,
    titleKey:'contactOptionalTitle',
    title:c.contactOptionalTitle||'Optional project context',
    bodyKey:'contactOptionalBody',
    body:c.contactOptionalBody||'Add company, buyer and location context if it helps us prepare the quotation.',
    fields:['company','buyerType','city','message']
  }
];

const fieldConfig:Record<string,any>={
  name:{
    labelKey:'name',
    label:c.name||'Contact Name',
    placeholderKey:'namePlaceholder',
    placeholder:c.namePlaceholder||'Your name',
    required:true,
    type:'text',
    autocomplete:'name',
    inputMode:'text',
    enterKeyHint:'next',
    autoCapitalize:'words',
    spellcheck:false
  },
  company:{
    labelKey:'company',
    label:c.company||'Company / Brand',
    placeholderKey:'companyPlaceholder',
    placeholder:c.companyPlaceholder||'Company or brand',
    required:false,
    type:'text',
    autocomplete:'organization',
    inputMode:'text',
    autoCapitalize:'words',
    spellcheck:false
  },
  country:{
    labelKey:'country',
    label:c.country||'Country / Region',
    placeholderKey:'countryPlaceholder',
    placeholder:c.countryPlaceholder||'Select country / region',
    required:true,
    type:'country'
  },
  city:{
    labelKey:'city',
    label:c.city||'City',
    placeholderKey:'cityPlaceholder',
    placeholder:c.cityPlaceholder||'City',
    required:false,
    type:'text',
    autocomplete:'address-level2',
    inputMode:'text',
    autoCapitalize:'words',
    spellcheck:false
  },
  email:{
    labelKey:'email',
    label:c.email||'Email',
    placeholderKey:'emailPlaceholder',
    placeholder:c.emailPlaceholder||'name@example.com',
    required:true,
    type:'email',
    autocomplete:'email',
    inputMode:'email',
    enterKeyHint:'next',
    autoCapitalize:'none',
    spellcheck:false
  },
  phone:{
    labelKey:'phone',
    label:c.phone||'WhatsApp / Phone / WeChat',
    placeholderKey:'phonePlaceholder',
    placeholder:c.phonePlaceholder||'Phone, WhatsApp number or WeChat ID',
    required:true,
    type:'text',
    autocomplete:'tel',
    inputMode:'text',
    enterKeyHint:'done',
    autoCapitalize:'none',
    spellcheck:false
  },
  buyerType:{
    labelKey:'buyerType',
    label:c.buyerType||'Buyer Type',
    placeholderKey:'selectBuyerType',
    placeholder:c.selectBuyerType||c.buyerType||'Select buyer type',
    required:false,
    type:'buyerType'
  },
  message:{
    labelKey:'message',
    label:c.message||'Other Notes',
    placeholderKey:'messagePlaceholder',
    placeholder:c.messagePlaceholder||'Anything else we should know about the project?',
    required:false,
    type:'textarea'
  }
};

const summaryRows=[
  {
    key:'items',
    labelKey:'selectedItems',
    label:c.selectedItems||'Items',
    value:summary.itemCount??0
  },
  {
    key:'quantity',
    labelKey:'totalQuantity',
    label:c.totalQuantity||'Total Quantity',
    value:`${summary.productQuantity??0} ${view.qtyUnit||'pcs'}`
  },
  {
    key:'estimate',
    labelKey:'productEstimate',
    label:c.productEstimate||'Estimated product amount',
    value:'—'
  }
];
---
<main
  class="contact-main"
  data-contact-static-presentation
  data-contact-runtime-presentation
  data-contact-conversion-composition="true"
  data-contact-input-efficiency="true"
>
  <section
    class="contact-hero"
    aria-labelledby="contactTitle"
  >
    <div class="home-container contact-hero__inner">
      <div>
        <p
          class="contact-eyebrow"
          data-contact-bind="contactKicker"
        >
          {c.contactKicker||'CONTACT'}
        </p>
        <h1
          id="contactTitle"
          data-contact-bind="contactTitle"
        >
          {c.contactTitle||'Add contact details'}
        </h1>
      </div>

      <p
        class="contact-hero__body"
        data-contact-bind="contactBody"
      >
        {c.contactBody||'We will use these details to confirm the quotation and project requirements.'}
      </p>
    </div>
  </section>

  <nav
    class="contact-progress home-container"
    aria-label={c.progressLabel||'Inquiry progress'}
    data-contact-static-progress
    data-contact-progress
  >
    <ol>
      <li
        class="is-complete"
        data-contact-static-step="selection"
      >
        <strong>01</strong>
        <span data-contact-bind="stepSelection">
          {c.stepSelection||'Inquiry'}
        </span>
      </li>
      <li
        class="is-active"
        data-contact-static-step="contact"
      >
        <strong>02</strong>
        <span data-contact-bind="stepContact">
          {c.stepContact||'Contact'}
        </span>
      </li>
      <li data-contact-static-step="review">
        <strong>03</strong>
        <span data-contact-bind="stepReview">
          {c.stepReview||'Review'}
        </span>
      </li>
    </ol>
  </nav>

  <section class="contact-workspace home-container">
    <section
      class="contact-form-shell"
      data-contact-static-form
      data-contact-form-shell
    >
      <form
        class="contact-form"
        aria-label={c.contactDetailsTitle||'Contact details'}
        data-contact-form
        novalidate
      >
        {sections.map((section:any)=>(
          <section
            class={`contact-section contact-section--${section.key}`}
            data-contact-static-section={section.key}
            data-contact-section={section.key}
          >
            <header class="contact-section__header">
              <p
                class="contact-eyebrow"
                data-contact-bind={section.kickerKey}
              >
                {section.kicker}
              </p>
              <h2 data-contact-bind={section.titleKey}>
                {section.title}
              </h2>
              <p data-contact-bind={section.bodyKey}>
                {section.body}
              </p>
            </header>

            <div class="contact-section__fields">
              {section.fields.map((key:string)=>{
                const field=fieldConfig[key]||{};
                const required=Boolean(field.required);
                const requirement=required?requiredLabel:optionalLabel;
                const requirementKey=required?'requiredLabel':'optionalLabel';

                if(field.type==='country'){
                  return (
                    <label
                      class="contact-field"
                      data-contact-field-shell="country"
                    >
                      <span class="contact-field__head">
                        <b data-contact-bind={field.labelKey}>
                          {field.label}
                        </b>
                        <small data-contact-bind={requirementKey}>
                          {requirement}
                        </small>
                      </span>
                      <select
                        disabled
                        required
                        autocomplete="country-name"
                        aria-describedby="countryError"
                        aria-invalid="false"
                        data-contact-static-field="country"
                        data-contact-field="country"
                        data-contact-country-select
                      >
                        <option value="">
                          {field.placeholder}
                        </option>
                        {countries.map((row:any)=>(
                          <option
                            value={row.code}
                            data-contact-static-country-option
                          >
                            {row.label} ({row.code})
                          </option>
                        ))}
                      </select>
                      <p
                        id="countryError"
                        class="contact-field__error"
                        data-contact-field-error="country"
                        hidden
                      ></p>
                    </label>
                  );
                }

                if(field.type==='buyerType'){
                  return (
                    <label
                      class="contact-field"
                      data-contact-field-shell="buyerType"
                    >
                      <span class="contact-field__head">
                        <b data-contact-bind={field.labelKey}>
                          {field.label}
                        </b>
                        <small data-contact-bind={requirementKey}>
                          {requirement}
                        </small>
                      </span>
                      <select
                        disabled
                        aria-describedby="buyerTypeError"
                        aria-invalid="false"
                        data-contact-static-field="buyerType"
                        data-contact-field="buyerType"
                        data-contact-buyer-select
                      >
                        <option value="">
                          {field.placeholder}
                        </option>
                        {buyerTypes.map((row:any)=>(
                          <option
                            value={row.value}
                            data-contact-static-buyer-option
                          >
                            {row.label}
                          </option>
                        ))}
                      </select>
                      <p
                        id="buyerTypeError"
                        class="contact-field__error"
                        data-contact-field-error="buyerType"
                        hidden
                      ></p>
                    </label>
                  );
                }

                if(field.type==='textarea'){
                  return (
                    <label
                      class="contact-field contact-field--wide"
                      data-contact-field-shell={key}
                    >
                      <span class="contact-field__head">
                        <b data-contact-bind={field.labelKey}>
                          {field.label}
                        </b>
                        <small data-contact-bind={requirementKey}>
                          {requirement}
                        </small>
                      </span>
                      <textarea
                        disabled
                        placeholder={field.placeholder}
                        aria-describedby={`${key}Error`}
                        aria-invalid="false"
                        data-contact-static-field={key}
                        data-contact-field={key}
                        data-contact-placeholder={field.placeholderKey}
                      >{contact[key]||''}</textarea>
                      <p
                        id={`${key}Error`}
                        class="contact-field__error"
                        data-contact-field-error={key}
                        hidden
                      ></p>
                    </label>
                  );
                }

                return (
                  <label
                    class="contact-field"
                    data-contact-field-shell={key}
                  >
                    <span class="contact-field__head">
                      <b data-contact-bind={field.labelKey}>
                        {field.label}
                      </b>
                      <small data-contact-bind={requirementKey}>
                        {requirement}
                      </small>
                    </span>
                    <input
                      disabled
                      required={required}
                      type={field.type}
                      autocomplete={field.autocomplete}
                      inputmode={field.inputMode}
                      enterkeyhint={field.enterKeyHint}
                      autocapitalize={field.autoCapitalize}
                      spellcheck={field.spellcheck}
                      aria-describedby={`${key}Error`}
                      aria-invalid="false"
                      placeholder={field.placeholder}
                      value={contact[key]||''}
                      data-contact-static-field={key}
                      data-contact-field={key}
                      data-contact-placeholder={field.placeholderKey}
                    />
                    <p
                      id={`${key}Error`}
                      class="contact-field__error"
                      data-contact-field-error={key}
                      hidden
                    ></p>
                  </label>
                );
              })}
            </div>
          </section>
        ))}

        <div
          class="contact-global-error"
          role="alert"
          data-contact-global-error
          hidden
        ></div>

        <div class="contact-actions">
          <a
            class="contact-action contact-action--secondary"
            href={view.routes.inquiry}
            data-contact-static-back
            data-contact-back
          >
            <span data-contact-bind="backInquiry">
              {c.backInquiry||'Back to Inquiry'}
            </span>
          </a>

          <button
            class="contact-action contact-action--primary"
            type="button"
            disabled
            data-contact-static-continue
            data-contact-continue
          >
            <span data-contact-bind="reviewInquiry">
              {c.reviewInquiry||'Review Inquiry'}
            </span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>

      <p
        class="contact-runtime-status"
        data-contact-runtime-status
        role="status"
        aria-live="polite"
      ></p>
    </section>

    <aside
      class="contact-rail"
      data-contact-static-summary
      data-contact-summary
    >
      <section class="contact-summary">
        <p
          class="contact-eyebrow"
          data-contact-bind="summaryKicker"
        >
          {c.summaryKicker||'YOUR INQUIRY'}
        </p>
        <h2 data-contact-bind="contactSnapshotTitle">
          {c.contactSnapshotTitle||c.summaryTitle||'Inquiry snapshot'}
        </h2>

        <div class="contact-summary__rows">
          {summaryRows.map((row:any)=>(
            <div>
              <span data-contact-bind={row.labelKey}>
                {row.label}
              </span>
              <strong
                data-contact-static-summary-value={row.key}
                data-contact-summary-value={row.key}
              >
                {row.value}
              </strong>
            </div>
          ))}
        </div>
      </section>

      <section class="contact-next">
        <p
          class="contact-eyebrow"
          data-contact-bind="whatNextKicker"
        >
          {c.whatNextKicker||'AFTER SUBMISSION'}
        </p>
        <h2 data-contact-bind="whatNextTitle">
          {c.whatNextTitle||'What happens after submission'}
        </h2>

        <ol data-contact-next-steps>
          {(c.whatNextSteps||[]).map((step:string,index:number)=>(
            <li>
              <b>{String(index+1).padStart(2,'0')}</b>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </section>
    </aside>
  </section>
</main>
