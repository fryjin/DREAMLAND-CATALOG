---
interface Props {
  content:Record<string,any>;
  languageOptions:Array<{
    value:string;
    label:string;
  }>;
  initialLanguage:string;
}

const {
  content,
  languageOptions,
  initialLanguage
}=Astro.props;

const nav=content?.navigation||{};
---
<header class="home-header" data-home-header>
  <div class="home-header__inner home-container">
    <a
      class="home-wordmark"
      href="/"
      aria-label="DREAMLAND home"
    >
      DREAMLAND
    </a>

    <nav
      class="home-nav"
      aria-label="Primary navigation"
    >
      <a href="/products/">
        <span data-home-bind="navigation.collection">
          {nav.collection||'Collection'}
        </span>
      </a>
      <a href="/custom/">
        <span data-home-bind="navigation.custom">
          {nav.custom||'Custom'}
        </span>
      </a>
      <a
        class="home-nav__inquiry"
        href="/inquiry/"
      >
        <span data-home-bind="navigation.inquiry">
          {nav.inquiry||'Inquiry'}
        </span>
        <span
          class="home-nav__count"
          data-home-inquiry-count
          aria-label="0 inquiry items"
        >
          0
        </span>
      </a>
    </nav>

    <label class="home-language-control">
      <span
        class="home-sr-only"
        data-home-bind="navigation.language"
      >
        {nav.language||'Language'}
      </span>
      <select
        data-home-language-select
        aria-label={nav.language||'Language'}
      >
        {languageOptions.map(option=>(
          <option
            value={option.value}
            selected={option.value===initialLanguage}
          >
            {option.label}
          </option>
        ))}
      </select>
    </label>
  </div>
</header>
