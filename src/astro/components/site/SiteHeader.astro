---
import {
  scopedPublicPath,
  withLocale
} from '../../lib/locale-routing.mjs';

interface Props {
  content:Record<string,any>;
  languageOptions:Array<{value:string;label:string;}>;
  initialLanguage:string;
  languageEnabled?:boolean;
  coverLanguageMenu?:boolean;
  routeLocale?:string;
  currentPath?:string;
}
const {
  content,
  languageOptions,
  initialLanguage,
  languageEnabled=true,
  coverLanguageMenu=false,
  routeLocale='',
  currentPath=''
}=Astro.props;
const nav=content?.navigation||{};
const routeHref=value=>
  scopedPublicPath(
    value,
    routeLocale
  );
---
<header class="dl-site-header home-header" data-dl-site-header data-home-header>
  <div class="dl-site-header__inner home-header__inner dl-container home-container">
    <a
      class="dl-wordmark home-wordmark"
      href={routeHref('/')}
      aria-label="DREAMLAND home"
    >
      <span class="home-wordmark__text">DREAMLAND</span>
      <span
        class="home-wordmark__graffiti"
        aria-hidden="true"
      >
        <img
          class="home-wordmark__graffiti-dream"
          src="/images/desktop/home/r4-1/hero-word-dream.png"
          alt=""
          width="760"
          height="340"
          loading="lazy"
        />
        <img
          class="home-wordmark__graffiti-land"
          src="/images/desktop/home/r4-1/hero-word-land.png"
          alt=""
          width="620"
          height="340"
          loading="lazy"
        />
      </span>
    </a>
    <nav class="dl-site-nav home-nav" aria-label="Primary navigation">
      <a href={routeHref('/products/')}><span data-home-bind="navigation.collection">{nav.collection||'Collection'}</span></a>
      <a href={routeHref('/custom/')}><span data-home-bind="navigation.custom">{nav.custom||'Custom'}</span></a>
    </nav>
    <div class="dl-site-actions">
      <label class="dl-language-control home-language-control">
        <span class="dl-sr-only home-sr-only" data-home-bind="navigation.language">{nav.language||'Language'}</span>
        <select
          data-home-language-select
          data-locale-routing="true"
          data-site-language-enabled={languageEnabled?'true':'false'}
          aria-label={nav.language||'Language'}
          disabled={!languageEnabled}
        >
          {languageOptions.map(option=>(
            <option
              value={option.value}
              data-locale-href={withLocale(currentPath,option.value)}
              selected={option.value===initialLanguage}
            >{option.label}</option>
          ))}
        </select>
      </label>

      {coverLanguageMenu&&(
        <details class="home-cover-language">
          <summary aria-label={nav.language||'Language'}>
            <span
              class="home-cover-language__current"
              aria-hidden="true"
            ></span>
          </summary>

          <div
            class="home-cover-language__menu"
            role="group"
            aria-label={nav.language||'Language'}
          >
            {languageOptions.map(option=>(
              <button
                type="button"
                data-home-language-option={option.value}
                data-locale-href={withLocale(currentPath,option.value)}
              >
                {option.label}
              </button>
            ))}
          </div>
        </details>
      )}

      <a class="dl-inquiry-action home-nav__inquiry" href={routeHref('/inquiry/')}>
        <span data-home-bind="navigation.inquiry">{nav.inquiry||'Inquiry'}</span>
        <span class="dl-inquiry-count home-nav__count" data-home-inquiry-count aria-label="0 inquiry items">0</span>
      </a>
    </div>
  </div>
</header>
