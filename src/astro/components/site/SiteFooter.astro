---
import {scopedPublicPath} from '../../lib/locale-routing.mjs';

interface Props {
  content:Record<string,any>;
  routeLocale?:string;
}
const {
  content,
  routeLocale=''
}=Astro.props;
const footer=content?.footer||{};
const routeHref=value=>
  scopedPublicPath(
    value,
    routeLocale
  );
---
<footer class="dl-site-footer home-footer" data-dl-site-footer data-home-footer>
  <div class="dl-container home-container dl-site-footer__grid home-footer__grid">
    <div class="dl-site-footer__brand home-footer__brand">
      <div class="dl-wordmark home-wordmark">DREAMLAND</div>
      <p data-home-bind="footer.description">{footer.description||'Hand-carved candles for wholesale and custom projects.'}</p>
    </div>
    <div class="dl-site-footer__links home-footer__links">
      <div>
        <strong data-home-bind="footer.explore">{footer.explore||'Explore'}</strong>
        <a href={routeHref('/products/')}><span data-home-bind="footer.collection">{footer.collection||'Collection'}</span></a>
        <a href={routeHref('/products/?series=masterpiece')}><span data-home-bind="footer.masterpiece">{footer.masterpiece||'Masterpiece'}</span></a>
        <a href={routeHref('/products/?series=advanced')}><span data-home-bind="footer.advanced">{footer.advanced||'Advanced'}</span></a>
      </div>
      <div>
        <strong data-home-bind="footer.projects">{footer.projects||'Projects'}</strong>
        <a href={routeHref('/custom/')}><span data-home-bind="footer.custom">{footer.custom||'Custom'}</span></a>
        <a href={routeHref('/inquiry/')}><span data-home-bind="footer.inquiry">{footer.inquiry||'Inquiry'}</span></a>
      </div>
      <div>
        <strong data-home-bind="footer.legal">{footer.legal||'Legal'}</strong>
        <a href="/privacy/"><span data-home-bind="footer.privacy">{footer.privacy||'Privacy'}</span></a>
      </div>
    </div>
  </div>
  <div class="dl-container home-container dl-site-footer__bottom home-footer__bottom">
    <span data-home-bind="footer.copyright">{footer.copyright||'© DREAMLAND'}</span>
    <span>Hand-carved candle art</span>
  </div>
</footer>
