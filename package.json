{
  "name": "dreamland-catalog",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "scripts": {
    "data:build": "node scripts/build-data.mjs --write",
    "data:check": "node scripts/build-data.mjs --check",
    "data:contract": "node scripts/validate-product-data-contract.mjs",
    "frontend:foundation": "node scripts/validate-frontend-foundation.mjs",
    "storage:migration": "node scripts/validate-storage-migration.mjs",
    "validate": "node scripts/validate-project.mjs && npm run data:contract && npm run frontend:foundation && npm run storage:migration && npm run pwa:migration && npm run media:consolidation && npm run hooks:cleanup && npm run shared-assets:cleanup && npm run inquiry-media:cleanup && npm run submission:boundary && npm run risk:boundary && npm run inquiry-state:boundary && npm run inquiry-pricing:boundary && npm run inquiry-view-model:boundary && npm run inquiry-ui:boundary && npm run inquiry-projection:boundary && npm run contact-submission:boundary",
    "check": "npm run data:check && npm run validate",
    "pwa:migration": "node scripts/validate-pwa-migration.mjs",
    "media:consolidation": "node scripts/validate-media-consolidation.mjs",
    "hooks:cleanup": "node scripts/validate-media-hook-cleanup.mjs",
    "shared-assets:cleanup": "node scripts/validate-shared-asset-hook-cleanup.mjs",
    "inquiry-media:cleanup": "node scripts/validate-inquiry-media-hook-cleanup.mjs",
    "submission:boundary": "node scripts/validate-submission-service-boundary.mjs",
    "risk:boundary": "node scripts/validate-risk-service-boundary.mjs",
    "inquiry-state:boundary": "node scripts/validate-inquiry-feature-state-boundary.mjs",
    "inquiry-pricing:boundary": "node scripts/validate-inquiry-pricing-boundary.mjs",
    "inquiry-view-model:boundary": "node scripts/validate-inquiry-view-model-boundary.mjs",
    "inquiry-ui:boundary": "node scripts/validate-inquiry-ui-renderer-boundary.mjs",
    "inquiry-projection:boundary": "node scripts/validate-inquiry-projection-boundary.mjs",
    "contact-submission:boundary": "node scripts/validate-contact-submission-orchestration-boundary.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
